# ----------------------------
# Домени / порти
# ----------------------------
DOMAIN=wp.local
HTTP_PORT=8080

# ----------------------------
# База даних
# ----------------------------
DB_NAME=wp
DB_USER=wp
DB_PASSWORD=wp
DB_ROOT_PASSWORD=root
DB_HOST=db
DB_CHARSET=utf8mb4
DB_COLLATE=
DB_PREFIX=wp_

# ----------------------------
# phpMyAdmin
# ----------------------------
PMA_HOST=db
PMA_USER=root
# ВАЖЛИВО: не використовуй посилання на інші змінні всередині .env
# або просто прибери PMA_PASSWORD (compose вже має дефолт = DB_ROOT_PASSWORD)
PMA_PASSWORD=root
PMA_PORT=8081
PMA_UPLOAD_LIMIT=128M
# PMA_ARBITRARY=1

# ----------------------------
# Xdebug
# ----------------------------
XDEBUG_MODE=debug,develop
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

# ----------------------------
# Mailpit
# ----------------------------
MAILPIT_USER=admin
MAILPIT_PASS=secret123
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
MAILPIT_MAX_MESSAGES=5000

# ----------------------------
# Ліміти для PHP / WP-CLI
# ----------------------------
PHP_MEMORY_LIMIT=512M
MAX_EXEC_TIME=300

# ----------------------------
# (опційно) назва проекту Docker Compose
# ----------------------------
# COMPOSE_PROJECT_NAME=wp-local
