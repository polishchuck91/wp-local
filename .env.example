# Домени/порти
DOMAIN=wp.local
HTTP_PORT=8080

# Database
DB_NAME=wp
DB_USER=wp
DB_PASSWORD=wp
DB_ROOT_PASSWORD=root
DB_HOST=db
DB_CHARSET=utf8mb4
DB_COLLATE=

# phpMyAdmin
PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=${DB_ROOT_PASSWORD}
PMA_PORT=8081
PMA_UPLOAD_LIMIT=128M
# PMA_ARBITRARY=1

# Xdebug
XDEBUG_MODE=debug,develop
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

# Mailpit
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
MAILPIT_USER=admin
MAILPIT_PASS=secret123

# Memory for WP-CLI
PHP_MEMORY_LIMIT=512M
MAX_EXEC_TIME=300
